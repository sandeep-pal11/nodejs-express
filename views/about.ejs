<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%=title%></title>
</head>
<body>
    <h1><%=title%></h1>
    <p><%=description%></p>
<% if (description) {
    %><p><%=description%></p><%     
    
}
else {
    %><p>No description provided.</p><% 
}%>

<% let items = ['Item 1', 'Item 2', 'Item 3']; %>
<ul>
    <% items.forEach(function(item) { %>
        <li><%= item %></li>
    <% }); %>
</ul>


</body>
</html>